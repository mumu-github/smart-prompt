          "caretWithinBounds",
          "caretWindowMatch",
          "cursorWithinBounds",
          "semanticComposerHint"
        ],
        "allowWeakSignalClipboardFallback": false
      }
    },
    "trae": {
      "composerGuard": {
        "minWidth": 240,
        "minHeight": 36,
        "maxHeight": 260,
        "requireNearWindowBottom": true,
        "blockBroadDocument": true,
        "strongSignals": [
          "hasKeyboardFocus",
