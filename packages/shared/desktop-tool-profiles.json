{
  "schemaVersion": "smart-prompt-desktop-tool-profiles@1",
  "supportedProfiles": ["codex", "claude-code", "hermes", "workbuddy", "trae"],
  "trustedOverlayClickProfiles": ["codex", "workbuddy", "trae"],
  "profiles": [
