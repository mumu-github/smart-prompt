{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.2.6",
  "key": "",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://lovable.dev/*",
    "https://bolt.new/*",
    "https://v0.dev/*",
    "https://v0.app/*",
    "https://replit.com/*",
    "https://work-buddy.ai/*",
    "https://www.work-buddy.ai/*",
    "https://trae.ai/*",
    "https://www.trae.ai/*",
    "https://doubao.com/*",
    "https://www.doubao.com/*",
    "https://dola.com/*",
    "https://www.dola.com/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://www.deepseek.com/*",
    "http://127.0.0.1:17371/*",
    "http://localhost:17371/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://lovable.dev/*",
        "https://bolt.new/*",
        "https://v0.dev/*",
        "https://v0.app/*",
        "https://replit.com/*",
        "https://work-buddy.ai/*",
        "https://www.work-buddy.ai/*",
        "https://trae.ai/*",
        "https://www.trae.ai/*",
        "https://doubao.com/*",
        "https://www.doubao.com/*",
        "https://dola.com/*",
        "https://www.dola.com/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://www.deepseek.com/*"
      ],
      "js": [
        "src/smart-prompt-core.js",
        "src/prompt-session.js",
        "src/assistant-card.js",
        "src/site-adapters.js",
        "src/local-service-client.js",
        "src/activation-evidence.js",
        "src/prompt-engine.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/mascot-states/*.png",
        "src/assistant-card.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
